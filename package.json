{
  "name": "railguard",
  "version": "0.2.1",
  "description": "The agent loop that can't run away with your bill — budget guardrails, reliable structured output, typed tool calling, tenant-safe RAG. Zero runtime deps.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrojimenezdev/railguard-agentkit.git"
  },
  "homepage": "https://github.com/pedrojimenezdev/railguard-agentkit",
  "bugs": {
    "url": "https://github.com/pedrojimenezdev/railguard-agentkit/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\\\n')\"",
    "prepare": "npm run build",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "test:compiled": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "rag",
    "tool-calling",
    "structured-output",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
